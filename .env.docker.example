# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha.
#   cp .env.docker.example .env

# Senha do root do MySQL (interna ao Docker; invente uma forte)
MYSQL_ROOT_PASSWORD=troque_por_uma_senha_forte

# Segredo dos tokens de login (invente uma frase aleatoria bem longa)
JWT_SECRET=troque_por_um_segredo_aleatorio_bem_longo

# Senha do usuario "admin" criado no primeiro boot.
# Se deixar vazio, uma senha aleatoria e mostrada UMA unica vez nos logs:
#   docker compose logs backend
SEED_ADMIN_PASSWORD=

# Porta do site na maquina (acesse http://IP_DA_MAQUINA:8080)
APP_PORT=8080

# Alertas no Telegram (opcional — mesmos valores do seu .env local)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTA_ATRASO_SEG=120
