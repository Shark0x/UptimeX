# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha.
#   cp .env.docker.example .env

# PostgreSQL 17 e o banco principal do stack. O backend (API + motor) usa tres
# papeis: owner (dono do schema/roles/RLS), app (API, sujeito ao RLS por empresa) e
# worker (motor de monitoramento). Gere tres senhas fortes e distintas.
POSTGRES_DB=uptimex
POSTGRES_USER=uptimex_owner
POSTGRES_PASSWORD=troque_por_uma_senha_forte_e_aleatoria
POSTGRES_APP_PASSWORD=troque_por_uma_senha_exclusiva_para_a_api
POSTGRES_WORKER_PASSWORD=troque_por_uma_senha_exclusiva_para_o_monitor

# MySQL: usado SOMENTE para migrar dados do sistema antigo
# (docker compose --profile migration run --rm postgres-migrator).
# Em uma instalacao nova, do zero, deixe como esta — o MySQL nem sobe.
MYSQL_ROOT_PASSWORD=troque_apenas_se_for_migrar_do_mysql

# Chave usada para cifrar comunidades SNMP e tokens no banco (32+ caracteres).
# Gere uma chave exclusiva, por exemplo com: openssl rand -base64 48
DATA_ENCRYPTION_KEY=troque_por_uma_chave_de_criptografia_aleatoria

# Sessao HttpOnly. Em producao HTTPS, COOKIE_SECURE deve ser true.
SESSION_TTL_HOURS=12
COOKIE_SECURE=auto
COOKIE_SAME_SITE=lax

# Se vazio, somente IPs publicos unicast podem ser cadastrados. Para redes
# privadas/CGNAT ou para restringir tambem os publicos, liste os CIDRs exatos.
# Exemplo: 10.20.0.0/16,100.64.10.0/24,200.150.10.0/24
MONITOR_ALLOWED_CIDRS=
SNMP_ALLOWED_PORTS=161

# Senha do usuario "admin" criado no primeiro boot.
# Obrigatoria no primeiro boot e nunca exibida nos logs (12+ caracteres).
SEED_ADMIN_PASSWORD=TroquePorUmaSenhaAdminForte123!

# Porta do site na maquina (acesse http://IP_DA_MAQUINA:8080)
APP_PORT=8080

# Alertas no Telegram (opcional — mesmos valores do seu .env local)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTA_ATRASO_SEG=120

# Enviar endereco ao Nominatim e opt-in. Os tiles passam pelo proxy do backend.
EXTERNAL_GEOCODING_ENABLED=false

AUDIT_RETENTION_DAYS=365
AUDIT_IP_RETENTION_DAYS=90
ANTENNA_METRICS_RETENTION_DAYS=30

# Series temporais de ping. Raw alimenta 24h; hourly, 7/30d; daily, 90d/1 ano.
PING_RAW_RETENTION_DAYS=15
PING_HOURLY_RETENTION_MONTHS=12
# 0 = manter os agregados diarios indefinidamente
PING_DAILY_RETENTION_YEARS=0
PING_LOG_BATCH_SIZE=250
PING_LOG_FLUSH_MS=5000
PING_LOG_MAX_QUEUE_SIZE=20000
PING_ROLLUP_CATCHUP_HOURS=48
PING_PRUNE_BATCH_SIZE=10000
PING_DEGRADED_LATENCY_MS=150
PING_DEGRADED_PACKET_LOSS_PCT=2
