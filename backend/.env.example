PORT=4000
BIND_HOST=127.0.0.1
TRUST_PROXY_HOPS=0

# PostgreSQL 17. O backend usa dois papeis: app (API, sujeito ao RLS por empresa)
# e worker (motor de monitoramento). Suba o banco com: docker compose up -d postgres
# (o schema, as roles e o RLS nascem de postgres/init/*).
PGHOST=localhost
PGPORT=5432
PGDATABASE=uptimex
POSTGRES_APP_USER=uptimex_app
POSTGRES_APP_PASSWORD=troque_pela_senha_do_uptimex_app
POSTGRES_WORKER_USER=uptimex_worker
POSTGRES_WORKER_PASSWORD=troque_pela_senha_do_uptimex_worker

# Origem permitida no CORS (URL do frontend)
FRONTEND_URL=http://localhost:5173

# Chave usada para cifrar segredos armazenados no banco.
DATA_ENCRYPTION_KEY=troque_por_uma_chave_aleatoria_com_32_ou_mais_caracteres
SESSION_TTL_HOURS=12
COOKIE_SECURE=auto
COOKIE_SAME_SITE=lax
MONITOR_ALLOWED_CIDRS=
SNMP_ALLOWED_PORTS=161
ALLOW_PRIVATE_DEV_ORIGINS=false
SEED_ADMIN_PASSWORD=TroquePorUmaSenhaAdminForte123!
EXTERNAL_GEOCODING_ENABLED=false
AUDIT_RETENTION_DAYS=365
AUDIT_IP_RETENTION_DAYS=90
ANTENNA_METRICS_RETENTION_DAYS=30

# ---- Alertas no Telegram (opcional) ----
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token
# 2) Mande qualquer mensagem pro seu bot novo
# 3) Abra https://api.telegram.org/bot<SEU_TOKEN>/getUpdates e copie o "chat":{"id":...}
# 4) Preencha abaixo e reinicie o backend. Teste na tela Usuarios do sistema.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Segundos offline continuos antes de alertar queda (anti-ruido). Padrao: 120
ALERTA_ATRASO_SEG=120
